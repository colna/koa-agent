# ---- 服务 ----
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# ---- 模型（OpenAI 兼容端点）----
# 示例用 DeepSeek（本机网络可达）；OpenAI 官方（部分地区不可用）：
# OPENAI_BASE_URL=https://api.openai.com/v1 ，OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-flash

# ---- CORS ----
# 允许跨域直连的来源（web 在 3001 端口）；'*' 为开发默认（不限制）
CORS_ORIGIN=*

# ---- SP Agent（minerva BFF）----
# dev: https://admin-api-dev.sitin.ai ；prod: https://admin-api-prod.sitin.ai
SP_ADMIN_BASE_URL=https://admin-api-dev.sitin.ai
# 登录 admin 后台后，从浏览器开发者工具拿 sessionToken：
#   console: localStorage.sessionToken（或任一请求的 Authorization 头去掉 "Bearer "）
SP_ADMIN_TOKEN=
# 线上环境（工具 env=prod 时使用）：同样方式从线上 admin 后台取 sessionToken；
# 留空则 env=prod 的查询返回配置指引（不阻塞启动）
SP_ADMIN_BASE_URL_PROD=https://admin-api-prod.sitin.ai
SP_ADMIN_TOKEN_PROD=
# 备选（仅本地 minerva 场景）：用 scripts/make-sp-token.mjs 以 JWT_SECRET 自签；
# 注意：部署的 dev/prod 环境用独立 secret，自签 token 会被拒绝（已实测）
# 报表 / CSV 导出落盘目录
SP_REPORT_DIR=./data/reports

# ---- 会话持久化 ----
# SQLite 文件路径（目录自动创建）；':memory:' 则用进程内存（重启丢失）
AGENT_SQLITE_PATH=./data/agent.sqlite
# 送模型的上下文 token 预算（粗略估算）：长会话只保留最近轮次，超出部分不再送模型
AGENT_MAX_INPUT_TOKENS=48000

# ---- SLS 日志查询（sls-logs skill）----
# 凭证二选一：
# A) OAuth（推荐）：aliyun configure --mode OAuth --profile <名>（首次浏览器授权，STS 自动续期）
SLS_ALIYUN_PROFILE=
# B) 静态凭证文件（bash export 格式，见 skills/sls-logs/SKILL.md）
SLS_CREDS_PATH=~/.sls_creds
# 连接信息默认与 skill 预置一致（us-west-1 / dev-presence-service-log / dora-dev-stdout）
# SLS_ENDPOINT=us-west-1.log.aliyuncs.com
# SLS_PROJECT=dev-presence-service-log
# SLS_LOGSTORE=dora-dev-stdout
# 线上环境（工具 env=prod 时使用；同账号同 endpoint，仅 project/logstore 不同）
# SLS_PROJECT_PROD=prod-presence-service-log
# SLS_LOGSTORE_PROD=dora-prod-stdout
# python 用系统自带的（Homebrew python 3.13 的 pyexpat 损坏，SDK 跑不了）
SLS_PYTHON_BIN=/usr/bin/python3

# ---- BytePlus（DataFinder）查询（byteplus-query skill）----
# 凭证二选一（AK/SK 属敏感信息，不要写进本文件提交）：
# A) dotenv 文件路径（KEY=VALUE，可复用现有项目的 .env）
BYTEPLUS_ENV_FILE=
# B) 直接给凭证：
# BYTEPLUS_ACCESS_KEY=
# BYTEPLUS_SECRET_KEY=
# 可选：API 基址覆盖（默认 https://analytics.byteplusapi.com）
# BYTEPLUS_BASE_URL=

# ---- 知识库检索（RAG，colna-memo）----
# colna-memo 根目录（含 ./colna CLI 与 memory/）；留空则不注册 kb_search/kb_read 工具
KB_MEMO_DIR=


{
  "name": "koa-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Koa 3 + LangGraph Agent 服务 + Next.js 聊天界面（pnpm monorepo）",
  "engines": {
    "node": ">=22.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "scripts": {
    "dev:server": "pnpm --filter @koa-agent/server dev",
    "dev:web": "pnpm --filter @koa-agent/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
